{% extends 'base.html.twig' %}

{% block title %}{{ component.componentName }}{% endblock %}

{% block body %}

    <div class="content">

        <div class="subtitle">
            <h2>Matériel</h2>
        </div>

        <div class="action">
            <a href="{{ path('app_component_index') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_component_edit', {'id': component.id}) }}">Modifier</a>
                {{ include('component/_delete_form.html.twig') }}
            {% endif %}
        </div>

        <div class="subtitle">
            <h4 class="table-detail-name">{{ component.componentName }}</h4>
        </div>
		
        <div class="grid-container">
            <table class="table">
                <tbody>
                    <tr>
                        <th class="table-detail-label">Nom du matériel</th>
                        <td>{{ component.componentName }}</td>
                    </tr>
                    <tr>
                        <th class="table-detail-label">Type de matériel</th>
                        <td class="table-detail-cell">{{ component.componentType }}</td>
                    </tr>
                    <tr>
                        <th class="table-detail-label">Sous-catégorie</th>
                        <td class="table-detail-cell">{{ component.componentSubcategory }}</td>
                    </tr>
                    <tr>
                        <th class="table-detail-label">Déplacement</th>
                        <td class="table-detail-cell">{{ component.movementRules }}</td>
                    </tr>
                    <tr>
                        <th class="table-detail-label">Attaques</th>
                        <td class="table-detail-cell">{{ component.attackRules }}</td>
                    </tr>
                    <tr>
                        <th class="table-detail-label">Protection</th>
                        <td class="table-detail-cell">{{ component.protectionRules }}</td>
                    </tr>
                    <tr>
                        <th class="table-detail-label">Ligne de mire</th>
                        <td class="table-detail-cell">{{ component.lineOfSightRules }}</td>
                    </tr>
                    <tr>
                        <th class="table-detail-label">Photo</th>
                        <td class="table-detail-cell">{{ component.componentIcon }}</td>
                    </tr>
                    <tr>
                        <th class="table-detail-label">Camp</th>
                        <td>{{ component.componentSide }}</td>
                    </tr>
                    <tr>
                        <th class="table-detail-label">Description</th>
                        <td class="table-detail-cell">{{ component.componentDescription }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
		
        <div class="action">
            <a href="{{ path('app_component_index') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_component_edit', {'id': component.id}) }}">Modifier</a>
                {{ include('component/_delete_form.html.twig') }}
            {% endif %}
        </div>
{% endblock %}
