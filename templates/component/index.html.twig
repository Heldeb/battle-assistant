{% extends 'base.html.twig' %}

{% block title %}Liste du matériel{% endblock %}

{% block body %}
    <div class="content">
        <div class="subtitle">
            <h2>Liste du matériel</h2>
        </div>

        <div class="action">
            <a href="{{ path('app_home') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_component_new') }}">Nouveau</a>
            {% endif %}
        </div>

        <div class="grid-container">
            <table class="table">
                <thead>
                    <tr>
                        <th class="table-label">Nom du matériel</th>
                        <th class="table-label">Type de matériel</th>
                        <th class="table-label">Sous-catégorie</th>
                        <th class="table-label">Déplacement</th>
                        <th class="table-label">Attaque</th>
                        <th class="table-label">Protection</th>
                        <th class="table-label">Ligne de mire</th>
                        <th class="table-label">Image</th>
                        <th class="table-label">Camp</th>
                        <th class="table-label">Description</th>
                    </tr>
                </thead>
                <tbody>
                    {% for component in components %}
                        <tr>
                            <td class="table-cell">{{ component.id }}</td>
                            <td class="table-cell">{{ component.componentName }}</td>
                            <td class="table-cell">{{ component.componentType }}</td>
                            <td class="table-cell">{{ component.componentSubcategory }}</td>
                            <td class="table-cell">{{ component.movementRules }}</td>
                            <td class="table-cell">{{ component.attackRules }}</td>
                            <td class="table-cell">{{ component.protectionRules }}</td>
                            <td class="table-cell">{{ component.lineOfSightRules }}</td>
                            <td class="table-cell">{{ component.componentIcon }}</td>
                            <td class="table-cell">{{ component.componentSide }}</td>
                            <td class="table-cell">{{ component.componentDescription }}</td>
                            <td class="table-link">
                                <a href="{{ path('app_component_show', {'id': component.id}) }}">Détails</a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_component_edit', {'id': component.id}) }}">Modifier</a>
                                    {{ include('component/_delete_form.html.twig') }}
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td>Base de données vide</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="action">
            <a href="{{ path('app_home') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_component_new') }}">Nouveau</a>
            {% endif %}
        </div>
    </div>

{% endblock %}
