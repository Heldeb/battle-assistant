{% extends 'base.html.twig' %}

{% block title %}Liste des scénarios{% endblock %}

{% block body %}
	<h1>Liste des scénarios</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Nom du scénario</th>
				<th>Date de la bataille</th>
				<th>Nombre de médailles</th>
			</tr>
		</thead>
		<tbody>
			{% for scenario in scenarios %}
				<tr>
					<td>{{ scenario.scenarioName }}</td>
					<td>{{ scenario.dateOfTheBattle|date('d/m/Y') }}</td>
					<td>{{ scenario.medalCount }}</td>
					<td>
						<a href="{{ path('app_scenario_show', {'id': scenario.id}) }}">show</a>
						{% if is_granted('ROLE_ADMIN') %}
							<a href="{{ path('app_scenario_edit', {'id': scenario.id}) }}">edit</a>
						{% endif %}
					</td>
				</tr>
			{% else %}
				<tr>
					<td>no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
	{% if is_granted('ROLE_ADMIN') %}
		<a href="{{ path('app_scenario_new') }}">Create new</a>
	{% endif %}
{% endblock %}
