{% extends 'base.html.twig' %}

{% block title %}Liste des scénarios{% endblock %}

{% block body %}
	<div class="content">
		<div class="subtitle">
			<h2>Liste des scénarios</h2>
		</div>

		<div class="action">
			<a href="{{ path('app_scenario_index') }}">Retour</a>
			{% if is_granted('ROLE_ADMIN') %}
				<a href="{{ path('app_scenario_new') }}">Nouveau</a>
			{% endif %}
		</div>

		<div class="grid-container">
			<table class="table">
				<thead>
					<tr>
						<th class="table-label">Nom du scénario</th>
						<th class="table-label">Date de la bataille</th>
						<th class="table-label">Nombre de médailles</th>
					</tr>
				</thead>
				<tbody>
					{% for scenario in scenarios %}
						<tr>
							<td class="table-cell">{{ scenario.scenarioName }}</td>
							<td class="table-cell">{{ scenario.dateOfTheBattle|date('d/m/Y') }}</td>
							<td class="table-cell">{{ scenario.medalCount }}</td>
							<td class="table-link">
								<a href="{{ path('app_scenario_show', {'id': scenario.id}) }}">Détails</a>
								{% if is_granted('ROLE_ADMIN') %}
									<a href="{{ path('app_scenario_edit', {'id': scenario.id}) }}">Modifier</a>
									{{ include('scenario/_delete_form.html.twig') }}
								{% endif %}
							</td>
						</tr>
					{% else %}
						<tr>
							<td>Base de données vide</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		
		<div class="action">
			<a href="{{ path('app_scenario_index') }}">Retour</a>
			{% if is_granted('ROLE_ADMIN') %}
				<a href="{{ path('app_scenario_new') }}">Nouveau</a>
			{% endif %}
		</div>
	</div>

{% endblock %}
