{% extends 'base.html.twig' %}

{% block title %}Scenario index{% endblock %}

{% block body %}
    <h1>Scenario index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Scenario_name</th>
                <th>Medal_count</th>
                <th>Historical_description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for scenario in scenarios %}
            <tr>
                <td>{{ scenario.id }}</td>
                <td>{{ scenario.scenarioName }}</td>
                <td>{{ scenario.medalCount }}</td>
                <td>{{ scenario.historicalDescription }}</td>
                <td>
                    <a href="{{ path('app_scenario_show', {'id': scenario.id}) }}">show</a>
                    <a href="{{ path('app_scenario_edit', {'id': scenario.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_scenario_new') }}">Create new</a>
{% endblock %}
