{% extends 'base.html.twig' %}

{% block title %}Liste des plateaux{% endblock %}

{% block body %}
    <div class="content">
        <div class="subtitle">
            <h2>Liste des plateaux</h2>
        </div>

        <div class="action">
            <a href="{{ path('app_home') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_battlefield_new') }}">Nouveau</a>
            {% endif %}
        </div>

        <div class="grid-container">
            <table class="table">
                <thead>
                    <tr>
                        <th class="table-label">Type de plateau</th>
                    </tr>
                </thead>
                <tbody>
                    {% for battlefield in battlefields %}
                        <tr>
                            <td class="table-cell">{{ battlefield.battlefieldType }}</td>
                            <td class="table-link">
                                <a href="{{ path('app_battlefield_show', {'id': battlefield.id}) }}">Détails</a>
                                <a href="{{ path('app_battlefield_edit', {'id': battlefield.id}) }}">Modifier</a>
                                {{ include('battlefield/_delete_form.html.twig') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td>Base de données vide</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="action">
            <a href="{{ path('app_home') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_battlefield_new') }}">Nouveau</a>
            {% endif %}
        </div>

{% endblock %}
