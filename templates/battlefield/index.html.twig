{% extends 'base.html.twig' %}

{% block title %}Battlefield index{% endblock %}

{% block body %}
    <h1>Battlefield index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Battlefield_type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for battlefield in battlefields %}
            <tr>
                <td>{{ battlefield.id }}</td>
                <td>{{ battlefield.battlefieldType }}</td>
                <td>
                    <a href="{{ path('app_battlefield_show', {'id': battlefield.id}) }}">show</a>
                    <a href="{{ path('app_battlefield_edit', {'id': battlefield.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_battlefield_new') }}">Create new</a>
{% endblock %}
