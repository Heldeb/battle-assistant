{% extends 'base.html.twig' %}

{% block title %}{{ battlefield.battlefieldType }}{% endblock %}

{% block body %}
    <div class="content">

        <div class="subtitle">
            <h2>Plateau</h2>
        </div>

        <div class="action">
            <a href="{{ path('app_battlefield_index') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_battlefield_edit', {'id': battlefield.id}) }}">Modifier</a>
                {{ include('battlefield/_delete_form.html.twig') }}
            {% endif %}
        </div>


        <div class="subtitle">
            <h4 class="table-detail-name">{{ battlefield.battlefieldType }}</h4>
        </div>
		
        <div class="grid-container">
            <table class="table">
                <tbody>
                    <tr>
                        <th class="table-detail-label">Type de plateau</th>
                        <td>{{ battlefield.battlefieldType }}</td>
                    </tr>
                </tbody>
            </table>

            <div class="action">
                <a href="{{ path('app_battlefield_index') }}">Retour</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_battlefield_edit', {'id': battlefield.id}) }}">Modifier</a>
                    {{ include('battlefield/_delete_form.html.twig') }}
                {% endif %}
            </div>
{% endblock %}
