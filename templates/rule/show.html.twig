{% extends 'base.html.twig' %}

{% block title %}Rule{% endblock %}

{% block body %}
    <h1>Rule</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ rule.id }}</td>
            </tr>
            <tr>
                <th>Rule_name</th>
                <td>{{ rule.ruleName }}</td>
            </tr>
            <tr>
                <th>Rule_description</th>
                <td>{{ rule.ruleDescription }}</td>
            </tr>
            <tr>
                <th>Rule_step</th>
                <td>{{ rule.ruleStep }}</td>
            </tr>
            <tr>
                <th>Rule_type</th>
                <td>{{ rule.ruleType }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_rule_index') }}">back to list</a>

    <a href="{{ path('app_rule_edit', {'id': rule.id}) }}">edit</a>

    {{ include('rule/_delete_form.html.twig') }}
{% endblock %}
