{% extends 'base.html.twig' %}

{% block title %}Rule index{% endblock %}

{% block body %}
    <h1>Rule index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Rule_name</th>
                <th>Rule_description</th>
                <th>Rule_step</th>
                <th>Rule_type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for rule in rules %}
            <tr>
                <td>{{ rule.id }}</td>
                <td>{{ rule.ruleName }}</td>
                <td>{{ rule.ruleDescription }}</td>
                <td>{{ rule.ruleStep }}</td>
                <td>{{ rule.ruleType }}</td>
                <td>
                    <a href="{{ path('app_rule_show', {'id': rule.id}) }}">show</a>
                    <a href="{{ path('app_rule_edit', {'id': rule.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_rule_new') }}">Create new</a>
{% endblock %}
