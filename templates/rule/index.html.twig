{% extends 'base.html.twig' %}

{% block title %}Liste de règles{% endblock %}

{% block body %}
    <div class="content">
        <div class="subtitle">
            <h2>Liste de règles</h2>
        </div>

        <div class="action">
            <a href="{{ path('app_home') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_rule_new') }}">Nouveau</a>
            {% endif %}
        </div>

        <div class="grid-container">
            <table class="table">
                <thead>
                    <tr>
                        <th class="table-label">Type de règle</th>
                        <th class="table-label">Etape</th>
                        <th class="table-label">Nom de la règle</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rule in rules %}
                        <tr>
                            <td class="table-cell">{{ rule.ruleType }}</td>
                            <td class="table-cell">{{ rule.ruleStep }}</td>
                            <td class="table-cell">{{ rule.ruleName }}</td>
                            <td class="table-link">
                                <a href="{{ path('app_rule_show', {'id': rule.id}) }}">Détails</a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_rule_edit', {'id': rule.id}) }}">Modifier</a>
                                    {{ include('rule/_delete_form.html.twig') }}
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td>Base de données vide</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="action">
            <a href="{{ path('app_home') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_rule_new') }}">Nouveau</a>
            {% endif %}
        </div>
    </div>
{% endblock %}
