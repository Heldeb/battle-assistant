{% extends 'base.html.twig' %}

{% block title %}ExpansionPack index{% endblock %}

{% block body %}
    <h1>ExpansionPack index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Expansion_pack_name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for expansion_pack in expansion_packs %}
            <tr>
                <td>{{ expansion_pack.id }}</td>
                <td>{{ expansion_pack.expansionPackName }}</td>
                <td>
                    <a href="{{ path('app_expansion_pack_show', {'id': expansion_pack.id}) }}">show</a>
                    <a href="{{ path('app_expansion_pack_edit', {'id': expansion_pack.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_expansion_pack_new') }}">Create new</a>
{% endblock %}
