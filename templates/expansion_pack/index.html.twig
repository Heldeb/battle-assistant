{% extends 'base.html.twig' %}

{% block title %}Liste des extensions{% endblock %}

{% block body %}
    <div class="content">
        <div class="subtitle">
            <h2>Liste des extensions</h2>
        </div>

        <div class="action">
            <a href="{{ path('app_home') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_expansion_pack_new') }}">Nouveau</a>
            {% endif %}
        </div>
        
        <div class="grid-container">
            <table class="table">
                <thead>
                    <tr>
                        <th class="table-label">Nom des extensions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for expansion_pack in expansion_packs %}
                        <tr>
                            <td class="table-cell">{{ expansion_pack.expansionPackName }}</td>
                            <td class="table-link">
                                <a href="{{ path('app_expansion_pack_show', {'id': expansion_pack.id}) }}">Détails</a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_expansion_pack_edit', {'id': expansion_pack.id}) }}">Modifier</a>
                                    {{ include('expansion_pack/_delete_form.html.twig') }}
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td>Base de données vide</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
		
        <div class="action">
            <a href="{{ path('app_home') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_expansion_pack_new') }}">Nouveau</a>
            {% endif %}
        </div>
    </div>

{% endblock %}
