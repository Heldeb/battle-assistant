{% extends 'base.html.twig' %}

{% block title %}{{ expansion_pack.expansionPackName }}{% endblock %}

{% block body %}
    <div class="content">

        <div class="subtitle">
            <h2>Extension</h2>
        </div>

        <div class="action">
            <a href="{{ path('app_expansion_pack_index') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_expansion_pack_edit', {'id': expansion_pack.id}) }}">Modifier</a>
                {{ include('expansion_pack/_delete_form.html.twig') }}
            {% endif %}
        </div>

        <div class="subtitle">
            <h4 class="table-detail-name">{{ expansion_pack.expansionPackName }}</h4>
        </div>

        <div class="action">
            <a href="{{ path('app_expansion_pack_index') }}">Retour</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_expansion_pack_edit', {'id': expansion_pack.id}) }}">Modifier</a>
                {{ include('expansion_pack/_delete_form.html.twig') }}
            {% endif %}
        </div>
{% endblock %}
